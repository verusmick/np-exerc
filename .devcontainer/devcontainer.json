{
  "name": "Library UI - Next.js",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22",

  "postCreateCommand": "npm install",

  "postStartCommand": "nohup npm run dev -- --hostname 0.0.0.0 > /tmp/library-ui-next.log 2>&1 &",

  "forwardPorts": [3000],

  "portsAttributes": {
    "3000": {
      "label": "Library UI",
      "onAutoForward": "openPreview"
    }
  }
}