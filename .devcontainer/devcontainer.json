{
  "name": "Library - UI",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "updateContentCommand": "npm install",
  "postAttachCommand": "npm run dev",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Library UI",
      "onAutoForward": "openPreview"
    }
  }
}